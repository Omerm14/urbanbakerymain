# Password required to sign in to the private content editor at /editor.
EDITOR_PASSWORD=

# Redis credentials for persisting content editor changes.
# Add a Redis integration (Vercel Marketplace > Storage) to your Vercel
# project to get these automatically. Without them, the site still renders
# using the default content, but the editor cannot save changes.
KV_REST_API_URL=
KV_REST_API_TOKEN=
